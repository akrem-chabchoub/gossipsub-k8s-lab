{
  "uid": "gossipsub-lab",
  "title": "GossipSub lab",
  "tags": [
    "gossipsub",
    "lab"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "refresh": "5s",
  "templating": {
    "list": [
      {
        "name": "namespace",
        "type": "custom",
        "label": "Namespace",
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "query": "gossip-lab,gossip-mixed,gossip-lab-py",
        "options": [
          {
            "text": "gossip-lab",
            "value": "gossip-lab",
            "selected": false
          },
          {
            "text": "gossip-mixed",
            "value": "gossip-mixed",
            "selected": false
          },
          {
            "text": "gossip-lab-py",
            "value": "gossip-lab-py",
            "selected": false
          }
        ]
      },
      {
        "name": "publisher",
        "type": "custom",
        "label": "Publisher peer",
        "multi": false,
        "includeAll": false,
        "current": {
          "text": "go-peer-0",
          "value": "go-peer-0"
        },
        "query": "go-peer-0,py-peer-0",
        "options": [
          {
            "text": "go-peer-0",
            "value": "go-peer-0",
            "selected": true
          },
          {
            "text": "py-peer-0",
            "value": "py-peer-0",
            "selected": false
          }
        ]
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "1. Is the workload running?",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Publish attempts, successes, errors per second",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (namespace, peer) (rate(gossip_publish_attempted_total{namespace=~\"$namespace\"}[1m]))",
          "legendFormat": "attempted {{namespace}}/{{peer}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (namespace, peer) (rate(gossip_publish_success_total{namespace=~\"$namespace\"}[1m]))",
          "legendFormat": "success {{namespace}}/{{peer}}",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (namespace, peer) (rate(gossip_publish_errors_total{namespace=~\"$namespace\"}[1m]))",
          "legendFormat": "errors {{namespace}}/{{peer}}",
          "refId": "C"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 24,
        "h": 8
      },
      "description": "Question: Is the workload running?\n\nTarget rate is PUBLISH_RATE (10/s). Only the publisher peer is non-zero.",
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "type": "row",
      "title": "2. Are messages reaching subscribers?",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Unique deliveries per subscriber (per second)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (namespace, peer) (rate(gossip_deliveries_total{namespace=~\"$namespace\"}[1m]))",
          "legendFormat": "{{namespace}}/{{peer}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "description": "Question: Are messages reaching subscribers?\n\nDeduplicated by (publisher, seq). Each subscriber should show about PUBLISH_RATE.",
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Delivery completeness (fraction of expected)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (namespace) (rate(gossip_deliveries_total{namespace=~\"$namespace\",publisher=~\"$publisher\"}[1m])) / (clamp_min(count by (namespace) (gossip_build_info{namespace=~\"$namespace\"}) - 1, 1) * sum by (namespace) (rate(gossip_publish_success_total{namespace=~\"$namespace\",peer=~\"$publisher\"}[1m])))",
          "legendFormat": "{{namespace}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "description": "Question: Are messages reaching subscribers?\n\nExpected deliveries = publish rate x (subscribers - 1). Subscribers = peers in namespace minus publisher. The denominator is fixed during isolation, so isolated peers reduce completeness (tradeoffs.md D3).",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "type": "row",
      "title": "3. Is propagation slowing down?",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Delivery latency p50 / p95 / p99",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.50, sum by (le, namespace, impl) (rate(gossip_delivery_latency_seconds_bucket{namespace=~\"$namespace\"}[1m])))",
          "legendFormat": "p50 {{namespace}} {{impl}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, namespace, impl) (rate(gossip_delivery_latency_seconds_bucket{namespace=~\"$namespace\"}[1m])))",
          "legendFormat": "p95 {{namespace}} {{impl}}",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le, namespace, impl) (rate(gossip_delivery_latency_seconds_bucket{namespace=~\"$namespace\"}[1m])))",
          "legendFormat": "p99 {{namespace}} {{impl}}",
          "refId": "C"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 24,
        "h": 8
      },
      "description": "Question: Is propagation slowing down?\n\nAssumptions: publish time is the publisher's wall clock (UnixNano), receive time is the subscriber's wall clock. All pods run on one kind node, so they share a host clock. Negative values are counted as clock skew, not as latency. Histogram buckets: 1 ms to 5 s.",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "type": "row",
      "title": "4. Is connectivity changing?",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Connected peers per peer",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "gossip_connected_peers{namespace=~\"$namespace\"}",
          "legendFormat": "{{namespace}}/{{peer}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "description": "Question: Is connectivity changing?\n\nFull mesh of 5 per subscriber in a 6-peer network; 2 in a 3-peer validation network. Drops mean links changed.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "GossipSub mesh size per peer",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "gossip_mesh_peers{namespace=~\"$namespace\"}",
          "legendFormat": "{{namespace}}/{{peer}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "description": "Question: Is connectivity changing?\n\nMesh membership from GRAFT/PRUNE trace events (Go) and from the mesh size sampled each second (py). Mesh membership is a subset of connected peers.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 11,
      "type": "row",
      "title": "5. Is a process struggling?",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "CPU usage per peer (cores)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (namespace, pod) (rate(container_cpu_usage_seconds_total{namespace=~\"$namespace\",container=\"peer\"}[1m]))",
          "legendFormat": "{{namespace}}/{{pod}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 37,
        "w": 8,
        "h": 8
      },
      "description": "Question: Is a process struggling?\n\nLimit is 0.5 cores per peer.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "CPU throttled share per peer",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (namespace, pod) (rate(container_cpu_cfs_throttled_periods_total{namespace=~\"$namespace\",container=\"peer\"}[5m])) / sum by (namespace, pod) (rate(container_cpu_cfs_periods_total{namespace=~\"$namespace\",container=\"peer\"}[5m]))",
          "legendFormat": "{{namespace}}/{{pod}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 8,
        "y": 37,
        "w": 8,
        "h": 8
      },
      "description": "Question: Is a process struggling?\n\nFraction of CFS periods throttled. Above 0 means the container hit its CPU limit.",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Memory working set per peer",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (namespace, pod) (container_memory_working_set_bytes{namespace=~\"$namespace\",container=\"peer\"})",
          "legendFormat": "{{namespace}}/{{pod}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 16,
        "y": 37,
        "w": 8,
        "h": 8
      },
      "description": "Question: Is a process struggling?\n\nLimit is 256 MiB per peer.",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Restarts per peer (cumulative)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (namespace, pod) (kube_pod_container_status_restarts_total{namespace=~\"$namespace\",container=\"peer\"})",
          "legendFormat": "{{namespace}}/{{pod}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 45,
        "w": 24,
        "h": 6
      },
      "description": "Question: Is a process struggling?\n\nAny increase is a crash or liveness failure.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 16,
      "type": "row",
      "title": "6. Is telemetry missing?",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 51,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Scrape health (up) per peer",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "up{job=\"gossip-peers\",namespace=~\"$namespace\"}",
          "legendFormat": "{{namespace}}/{{pod}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 52,
        "w": 12,
        "h": 8
      },
      "description": "Question: Is telemetry missing?\n\n0 means Prometheus could not scrape the peer. A gap in the series also means missing data.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Seconds since last receipt per peer",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "time() - gossip_last_receive_timestamp_seconds{namespace=~\"$namespace\"}",
          "legendFormat": "{{namespace}}/{{peer}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 52,
        "w": 12,
        "h": 8
      },
      "description": "Question: Is telemetry missing?\n\nRises when a peer stops receiving. Also rises during isolation, so read with the connectivity panels.",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 19,
      "type": "row",
      "title": "7. Individual message timeline (VictoriaLogs)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 60,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 900,
      "type": "text",
      "title": "Per-message receipt timeline",
      "gridPos": {
        "x": 0,
        "y": 61,
        "w": 24,
        "h": 6
      },
      "options": {
        "mode": "markdown",
        "content": "Run this in the VictoriaLogs UI (http://localhost:9428/select/vmui via port-forward) or the API. Replace RUN_ID and SEQ.\n\n```\n_time:1h runId:RUN_ID seq:SEQ event:receive | fields _time, peer, publisherName, latencyMs, fromName | sort by (_time)\n```\n\nSee `observability/queries/logsql.md` for the full query set."
      }
    }
  ]
}